<!DOCTYPE html>
<html lang="it" class="sidebar sidebar-discover">

<head>
    <link rel="stylesheet" href="/css/annuncio.css">
    <title>BKY - Annuncio-Moscarossa</title>
    <%- include('../../partials/head'); %>
    <script type="text/javascript"
        src="/assets/components/common/forms/calendar/jquery.simple-calendar.min.js"></script>
    <link rel="stylesheet" type="text/css"
        href="/assets/components/common/forms/calendar/css/simple-calendar.css">
    <style>
        .moscarossa-form-section {
            margin-bottom: 5px;
        }

        .moscarossa-form-section-title {
            display: none;
        }

        .moscarossa-phone-panel {
            min-height: 190px;
        }

        .moscarossa-phone-panel .flex-checkbox {
            margin-top: 8px;
        }

        .moscarossa-save-row {
            margin-top: 18px;
        }

        .moscarossa-image-grid {
            display: contents;
        }

        #moscarossaActiveImages {
            position: relative;
        }

        #moscarossaActiveImages .dragHere {
            pointer-events: none;
        }

        .moscarossa-image-card {
            cursor: default;
        }

        .moscarossa-image-card.is-preview {
            background-color: gold;
        }

        .moscarossa-image-card .pic-wrapper {
            cursor: pointer;
        }

        .moscarossa-image-card .btn {
            width: 37px;
        }

        .moscarossa-image-actions .btn {
            transform: translateY(-7px);
        }

        .pics.removed {
            display: none;
        }

        .moscarossa-pending-note {
            margin: 12px 0;
        }

        #moscarossa-link-form {
            display: flex;
            gap: 8px;
        }

        #moscarossa-link-form .form-control {
            flex: 1;
        }

        .moscarossa-publication-layout {
            display: grid;
            grid-template-columns: minmax(280px, 420px) minmax(0, 1fr);
            gap: 24px;
            align-items: start;
        }

        .moscarossa-date-control {
            margin-bottom: 15px;
        }

        .moscarossa-free-header,
        .moscarossa-slot-main,
        .moscarossa-history-main {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .moscarossa-free-header {
            justify-content: space-between;
            padding: 12px 15px;
            background: #e8e8e8;
            border-left: 4px solid #d71920;
        }

        .moscarossa-schedule-slot {
            margin-top: 12px;
            padding: 14px;
            border: 1px solid #d8d8d8;
            border-radius: 4px;
            background: #fff;
        }

        .moscarossa-slot-main .form-control {
            width: 130px;
        }

        .moscarossa-slot-date {
            min-width: 92px;
            font-weight: 700;
        }

        .moscarossa-slot-images {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(105px, 1fr));
            gap: 10px;
            margin-top: 14px;
        }

        .moscarossa-slot-image {
            position: relative;
            padding: 6px;
            border: 2px solid transparent;
            border-radius: 4px;
            background: #eee;
        }

        .moscarossa-slot-image.is-selected {
            border-color: #5cb85c;
        }

        .moscarossa-slot-image.is-preview {
            background: #f7d85b;
            border-color: #e1b900;
        }

        .moscarossa-slot-image img {
            width: 100%;
            height: 92px;
            object-fit: cover;
        }

        .moscarossa-slot-image-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 5px;
        }

        .moscarossa-history-item {
            padding: 12px 0;
            border-bottom: 1px solid #ddd;
        }

        .moscarossa-history-main {
            justify-content: space-between;
            flex-wrap: wrap;
        }

        .moscarossa-history-error {
            margin: 10px 0 0;
            display: none;
            white-space: pre-wrap;
        }

        @media (max-width: 900px) {
            .moscarossa-publication-layout {
                grid-template-columns: 1fr;
            }
        }

    </style>
</head>

<body class="scripts-async wysihtml5-supported menu-left-visible">
    <input id="annuncioID" type="hidden" value="new">
    <input id="donnaID" type="hidden" name="donnaID" value="new">
    <input id="panel" type="hidden" name="panel" value="moscarossa">

    <div class="container-fluid menu-hidden" style="visibility: visible;">
        <%- include('../../partials/menu'); %>
        <div id="content">
            <%- include('../../partials/header'); %>
            <h1 id="moscarossaPageTitle">Nuovo Annuncio-Moscarossa</h1>

            <div class="innerLR">
                <div class="widget widget-heading-simple widget-body-gray" id="moscarossaImportSection">
                    <div class="widget-head">
                        <h3 class="heading glyphicons download"><i></i>Carica un annuncio</h3>
                    </div>
                    <div class="widget-body">
                        <label for="moscarossa-link-to-scrape">Carica da link pubblico Moscarossa</label>
                        <div id="moscarossa-link-form">
                            <input id="moscarossa-link-to-scrape" class="form-control" type="url"
                                placeholder="https://www.moscarossa.biz/girl-123.php">
                            <button class="btn btn-info" type="button" id="moscarossa-caricalink-button"
                                aria-label="Carica annuncio Moscarossa">
                                <i class="fa fa-arrow-right"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="widget widget-heading-simple widget-body-gray widget-annuncio">
                    <div class="widget-head">
                        <h3 class="heading glyphicons edit"><i></i>Informazioni</h3>
                        <button id="moscarossaEditInfo" type="button"
                            class="input-editor btn btn-success pull-right" style="display:none;"
                            aria-label="Modifica informazioni">
                            <i class="fa fa-pen"></i>
                        </button>
                    </div>
                    <div class="widget-body">
                        <form id="moscarossaInfoForm" novalidate>
                            <div class="innerB">
                                <label for="moscarossaTitle">Titolo *</label>
                                <textarea id="moscarossaTitle" name="title" maxlength="150" rows="2"
                                    class="form-control" placeholder="5 caratteri necessari" required></textarea>
                            </div>

                            <div class="innerB">
                                <label for="moscarossaDescription">Descrizione *</label>
                                <textarea id="moscarossaDescription" name="description" rows="12"
                                    class="form-control" placeholder="Minimo 20 caratteri necessari" required></textarea>
                            </div>

                            <div class="moscarossa-form-section">
                                <h4 class="moscarossa-form-section-title">Località</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaCityId">Comune *</label>
                                            <input id="moscarossaCity" name="city" type="hidden">
                                            <input id="moscarossaCityId" name="cityId" type="hidden"
                                                style="width:100%;" data-placeholder="Scrivi una città/comune">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaZone">Zona/quartiere</label>
                                            <input id="moscarossaZone" name="location" type="text" class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaAddress">Indirizzo</label>
                                            <input id="moscarossaAddress" name="address" type="text"
                                                class="form-control" placeholder="Es: Via Roma, 1">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="innerB">
                                            <label for="moscarossaZoneDetail">Dettaglio zona</label>
                                            <input id="moscarossaZoneDetail" name="zoneDetail" type="text"
                                                maxlength="150" class="form-control"
                                                placeholder="Es: vicino alla stazione">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="innerB">
                                            <label for="moscarossaWebsite">Sito web personale</label>
                                            <input id="moscarossaWebsite" name="website" type="url" maxlength="250"
                                                class="form-control">
                                        </div>
                                    </div>
                                </div>
                                <p class="help-block">
                                    Scrivi almeno due caratteri e seleziona il Comune restituito da Moscarossa.
                                </p>
                            </div>

                            <div class="moscarossa-form-section">
                                <h4 class="moscarossa-form-section-title">Dati annuncio</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaName">Nome *</label>
                                            <input id="moscarossaName" name="name" type="text" maxlength="30"
                                                class="form-control" required>
                                        </div>
                                        <div class="innerB">
                                            <label for="moscarossaAge">Età</label>
                                            <input id="moscarossaAge" name="age" type="number" min="18" max="99"
                                                class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaCategory">Categoria *</label>
                                            <select id="moscarossaCategory" name="categorie" class="form-control" required>
                                                <option value="">Seleziona una categoria</option>
                                                <option value="DONNAUOMO">Escort donne</option>
                                                <option value="TRANS">Trans</option>
                                                <option value="UOMODONNA">Gigolò</option>
                                                <option value="MASSAGGI">Massaggi</option>
                                            </select>
                                        </div>
                                        <div class="innerB">
                                            <div class="flex-checkbox">
                                                <input id="moscarossaAirConditioned" name="airConditioned" type="checkbox">
                                                <label for="moscarossaAirConditioned">Ambiente climatizzato</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="phone-panel moscarossa-phone-panel">
                                            <label for="moscarossaPhone">Contatto telefonico *</label>
                                            <div class="phone-wrapper">
                                                <input id="moscarossaPhone" name="phone" type="tel" maxlength="50"
                                                    class="form-control" required>
                                                <button id="verify-button" type="button" class="btn btn-secondary">
                                                    <span><i class="fa fa-arrow-right"></i></span>
                                                </button>
                                            </div>
                                            <p id="test-label">Verifica</p>
                                            <div class="flex-checkbox" style="margin-bottom: 5px;">
                                                <input id="moscarossaWhatsapp" name="whatsapp" type="checkbox">
                                                <label for="moscarossaWhatsapp">WhatsApp</label>
                                            </div>
                                            <div class="flex-checkbox" style="margin-bottom: 5px;">
                                                <input id="moscarossaTelegram" name="telegram" type="checkbox">
                                                <label for="moscarossaTelegram">Telegram</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <input id="moscarossaZoneId" name="zoneId" type="hidden">
                            <input id="moscarossaLatitude" name="latitude" type="hidden">
                            <input id="moscarossaLongitude" name="longitude" type="hidden">

                            <div class="innerB moscarossa-save-row">
                                <button id="moscarossaSaveInfo" type="submit" class="btn btn-info"
                                    style="width: 100%;">
                                    <b>SALVA</b>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="widget widget-heading-simple widget-body-gray">
                    <div class="widget-head">
                        <h3 class="heading glyphicons edit"><i></i>Immagini</h3>
                        <button class="input-editor btn btn-success pull-right" id="moscarossaShowRemoved"
                            type="button" aria-label="Mostra immagini rimosse">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>
                    <div class="widget-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="pics-section">
                                    <div class="pics persistent" id="moscarossaActiveImages">
                                        <div class="dragHere"
                                            style="position:absolute; width:100%; height:100%; background-color:#8597d8; opacity:.8; display:none; z-index:1000;">
                                            <div
                                                style="position:relative; width:calc(100% - 20px); height:calc(100% - 20px); border:dashed 10px #ddd; border-radius:50px; margin:10px;">
                                                <div style="font-size:5em; text-align:center; padding:80px 0 0;">
                                                    <span class="fa fa-cloud-upload" style="color:white;"></span>
                                                </div>
                                                <h1 style="color:white; font-size:3em; text-align:center; padding:30px;">
                                                    Trascina Qui
                                                </h1>
                                            </div>
                                        </div>
                                        <input id="moscarossaImages" type="file" accept="image/*" multiple
                                            style="display:none;">
                                        <label for="moscarossaImages">
                                            <div class="add-pic"><b><i class="fa fa-plus"></i></b></div>
                                        </label>
                                        <div id="moscarossaImageGrid" class="moscarossa-image-grid"></div>
                                    </div>
                                    <div class="pics removed" id="moscarossaRemovedImages">
                                        <div id="moscarossaRemovedImageGrid" class="moscarossa-image-grid"></div>
                                    </div>
                                    <p><b>Massimo 20 immagini, 5 MB per file.</b> Clicca una foto per impostarla
                                        come anteprima.</p>
                                    <p id="moscarossaNewAdImageHelp"
                                        class="help-block moscarossa-pending-note" style="display:none;">
                                        Salva prima le informazioni dell'annuncio, quindi aggiungi le immagini.
                                    </p>
                                    <button id="moscarossaSaveImages" type="button" class="btn btn-primary"
                                        style="width:100%; margin-top:20px;" disabled>
                                        <b>MODIFICA LE IMMAGINI</b>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="widget widget-heading-simple widget-body-gray widget-after" id="moscarossaPublications">
                    <div class="widget-head">
                        <h3 class="heading glyphicons edit"><i></i>Pubblicazioni</h3>
                    </div>
                    <div class="widget-body">
                        <div class="moscarossa-publication-layout">
                            <div>
                                <label for="moscarossaScheduleDate">Data pubblicazione</label>
                                <input id="moscarossaScheduleDate" type="date"
                                    class="form-control moscarossa-date-control">
                                <div id="moscarossaCalendarContainer"></div>
                            </div>
                            <div>
                                <div class="moscarossa-free-header">
                                    <div>
                                        <strong>Free</strong>
                                        <div class="text-muted">PUBBLICA GRATIS · massimo 3 immagini</div>
                                    </div>
                                    <button id="moscarossaAddSchedule" type="button" class="btn btn-primary">
                                        <i class="fa fa-plus"></i> Aggiungi
                                    </button>
                                </div>
                                <div id="moscarossaScheduleList"></div>
                            </div>
                        </div>
                        <div class="separator"></div>
                        <button id="moscarossaSaveSchedule" type="button" class="btn btn-success"
                            style="width:100%;" disabled>
                            <b>SALVA TUTTE LE PUBBLICAZIONI FREE</b>
                        </button>
                    </div>
                </div>

                <div class="widget widget-body-gray widget-after" id="moscarossaHistory">
                    <div class="widget-head" style="background:#eaeaea;">
                        <h3 class="heading glyphicons edit" style="margin-left:-10px;"><i></i>Storico Pubblicazioni</h3>
                        <button id="moscarossaRefreshHistory" type="button" class="btn btn-xs pull-right"
                            aria-label="Aggiorna storico">
                            <i class="fa fa-refresh"></i>
                        </button>
                    </div>
                    <div class="widget-body">
                        <div id="moscarossaHistoryList">
                            <div class="row center">Nessun dato rilevato</div>
                        </div>
                    </div>
                </div>
            </div>

            <footer>
                <%- include('../../partials/footer'); %>
            </footer>
        </div>
    </div>

    <div class="loader">
        <img src="/assets/loader.gif" alt="Caricamento">
    </div>
    <script src="/js/panels/moscarossa/main.js?v=20260804-import"></script>
    <script src="/js/panels/moscarossa/schedule.js?v=20260804-free-history"></script>
</body>

</html>

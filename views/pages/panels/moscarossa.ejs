<!DOCTYPE html>
<html lang="it" class="sidebar sidebar-discover">

<head>
    <link rel="stylesheet" href="/css/annuncio.css?v=20260826-moscarossa-promo-prices">
    <title>BKY - Annuncio-Moscarossa</title>
    <%- include('../../partials/head'); %>
    <link rel="stylesheet" href="/css/cropper.css">
    <script src="/js/cropper.js"></script>
    <script type="text/javascript"
        src="/assets/components/common/forms/calendar/jquery.simple-calendar.min.js"></script>
    <link rel="stylesheet" type="text/css"
        href="/assets/components/common/forms/calendar/css/simple-calendar.css">
    <style>
        .custom-modal {
            display: none;
            position: fixed;
            z-index: 1100;
            inset: 0;
            overflow: auto;
            background: rgba(0, 0, 0, .5);
        }

        .custom-modal-content {
            width: 80%;
            max-width: 800px;
            margin: 8% auto;
            padding: 20px;
            border: 1px solid #888;
            border-radius: 8px;
            background: #fff;
        }

        .custom-modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            padding-bottom: 10px;
            border-bottom: 1px solid #ddd;
        }

        .custom-modal-title {
            font-size: 1.5em;
            font-weight: 700;
        }

        .custom-modal-close {
            border: 0;
            background: transparent;
            font-size: 1.5em;
        }

        .custom-modal-body {
            margin-bottom: 20px;
        }

        .custom-modal-footer {
            text-align: right;
        }

        .custom-modal-save {
            padding: 8px 16px;
            border: 0;
            border-radius: 4px;
            color: #fff;
            background: #007bff;
        }

        .moscarossa-form-section {
            margin-bottom: 5px;
        }

        .moscarossa-form-section-title {
            display: none;
        }

        .moscarossa-phone-panel {
            min-height: 190px;
        }

        .moscarossa-phone-panel .flex-checkbox {
            margin-top: 8px;
        }

        .moscarossa-save-row {
            margin-top: 18px;
        }

        .moscarossa-image-grid {
            display: contents;
        }

        #moscarossaActiveImages {
            position: relative;
        }

        #moscarossaActiveImages .dragHere {
            pointer-events: none;
        }

        .moscarossa-image-card {
            cursor: default;
        }

        .moscarossa-image-card.is-preview {
            background-color: gold;
        }

        .moscarossa-image-card .pic-wrapper {
            cursor: pointer;
        }

        .moscarossa-image-card .btn {
            width: 37px;
        }

        .moscarossa-image-actions .btn {
            transform: translateY(-7px);
        }

        .pics.removed {
            display: none;
        }

        .moscarossa-pending-note {
            margin: 12px 0;
        }

        .widget-after {
            display: none;
        }

        #moscarossaHistorySuspendedTitle {
            display: none;
        }

        #moscarossaHistorySuspendedList {
            display: none;
        }

        .moscarossa-history-bulk .btn {
            width: 100%;
            margin-top: 20px;
        }

        .moscarossa-addons {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            width: 100%;
            margin: 10px 0 4px;
        }

        .moscarossa-addon {
            flex: 1 1 360px;
            padding: 12px;
            border: 1px solid #eadfb6;
            border-radius: 4px;
            background: #fffbea;
        }

        .moscarossa-addon-diamond {
            border-color: #ead1e7;
            background: #fff0fc;
        }

        .moscarossa-addon-controls {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin-top: 8px;
        }

        .moscarossa-addon-controls .form-control {
            width: auto;
            min-width: 145px;
        }

        .moscarossa-diamond-dates {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
            margin-top: 8px;
        }

        .moscarossa-diamond-date {
            padding: 4px 8px;
            border: 0;
            border-radius: 3px;
            color: #fff;
            background: #a43b91;
        }

        .moscarossa-story-input {
            display: none !important;
        }

        .moscarossa-details {
            margin: 12px 0 18px;
            border: 1px solid #ddd;
            border-radius: 4px;
            background: #fff;
        }

        .moscarossa-details > summary {
            padding: 13px 16px;
            cursor: pointer;
            font-size: 15px;
            font-weight: 700;
            background: #f5f5f5;
        }

        .moscarossa-details-body {
            padding: 14px 16px 4px;
        }

        .moscarossa-details-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px 16px;
            margin-bottom: 18px;
        }

        .moscarossa-details-grid.services {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .moscarossa-tariff-list {
            margin-bottom: 18px;
            border-top: 1px solid #e5e5e5;
        }

        .moscarossa-tariff-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            min-height: 44px;
            padding: 4px 0 4px 16px;
            border-bottom: 1px solid #e5e5e5;
        }

        .moscarossa-tariff-row > label {
            margin: 0;
            font-weight: 600;
        }

        .moscarossa-tariff-input {
            width: 130px;
            flex: 0 0 130px;
        }

        .moscarossa-tariff-heading {
            margin: 0;
            padding: 14px 16px 9px;
            border-bottom: 1px solid #e5e5e5;
            font-size: 20px;
            font-weight: 700;
        }

        .moscarossa-detail-item label {
            display: block;
            margin-bottom: 4px;
        }

        .moscarossa-service-item {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 120px;
            align-items: center;
            gap: 8px;
            min-height: 35px;
        }

        .moscarossa-service-item .flex-checkbox {
            margin: 0;
        }

        .moscarossa-choice-list {
            display: flex;
            flex-wrap: wrap;
            gap: 8px 16px;
        }

        .moscarossa-choice-list .flex-checkbox {
            min-width: 150px;
            margin: 0;
        }

        @media (max-width: 767px) {
            .moscarossa-details-grid,
            .moscarossa-details-grid.services {
                grid-template-columns: 1fr;
            }

            .moscarossa-tariff-row {
                padding-left: 8px;
            }
        }

    </style>
</head>

<body class="scripts-async wysihtml5-supported menu-left-visible">
    <input id="annuncioID" type="hidden" value="new">
    <input id="donnaID" type="hidden" name="donnaID" value="new">
    <input id="panel" type="hidden" name="panel" value="moscarossa">

    <div class="container-fluid menu-hidden" style="visibility: visible;">
        <%- include('../../partials/menu'); %>
        <div id="content">
            <%- include('../../partials/header'); %>
            <h1 id="moscarossaPageTitle">Nuovo Annuncio-Moscarossa</h1>

            <div class="innerLR">
                <div class="widget widget-heading-simple widget-body-gray">
                    <div class="widget-body">
                        <p>E' servamente vietato inserire foto, testi, titoli con riferimenti a donna incinta o
                            foto pornografiche.
                        </p>
                    </div>
                </div>

                <div class="widget widget-heading-simple widget-body-gray" id="moscarossaImportSection">
                    <div class="widget-head">
                        <h3 class="heading glyphicons download"><i></i>Carica un annuncio</h3>
                    </div>
                    <div class="widget-body">
                        <div class="row">
                            <div class="col-md-6">
                                <label for="link-to-scrape">Carica da link</label>
                                <div id="link-form">
                                    <input id="link-to-scrape" class="form-control" type="text"
                                        placeholder="Inserisci URL">
                                    <button class="btn btn-info" type="button" id="caricalink-button"
                                        aria-label="Carica annuncio Moscarossa">
                                        <i class="fa fa-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="select2_3">Carica ultimo annuncio di:</label>
                                <div id="phone-form">
                                    <select style="width:100%;" id="select2_3">
                                        <option value="">Seleziona cliente</option>
                                    </select>
                                    <button class="btn btn-info" type="button" id="caricaphone-button"
                                        aria-label="Carica ultimo annuncio">
                                        <i class="fa fa-arrow-right"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="widget widget-heading-simple widget-body-gray widget-annuncio">
                    <div class="widget-head">
                        <h3 class="heading glyphicons edit"><i></i>Informazioni</h3>
                        <button id="moscarossaEditInfo" type="button"
                            class="input-editor btn btn-success pull-right" style="display:none;"
                            aria-label="Modifica informazioni">
                            <i class="fa fa-pen"></i>
                        </button>
                    </div>
                    <div class="widget-body">
                        <form id="moscarossaInfoForm" novalidate>
                            <div class="innerB">
                                <label for="moscarossaTitle">Titolo *</label>
                                <textarea id="moscarossaTitle" name="title" maxlength="150" rows="2"
                                    class="form-control" placeholder="5 caratteri necessari" required></textarea>
                            </div>

                            <div class="innerB">
                                <label for="moscarossaDescription">Descrizione *</label>
                                <textarea id="moscarossaDescription" name="description" rows="12"
                                    class="form-control" placeholder="Minimo 20 caratteri necessari" required></textarea>
                            </div>

                            <div class="moscarossa-form-section">
                                <h4 class="moscarossa-form-section-title">Località</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaCityId">Comune *</label>
                                            <input id="moscarossaCity" name="city" type="hidden">
                                            <input id="moscarossaCityId" name="cityId" type="hidden"
                                                style="width:100%;" data-placeholder="Scrivi una città/comune">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaZone">Zona/quartiere</label>
                                            <input id="moscarossaZone" name="location" type="text" class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaAddress">Indirizzo</label>
                                            <input id="moscarossaAddress" name="address" type="text"
                                                class="form-control" placeholder="Es: Via Roma, 1">
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="innerB">
                                            <label for="moscarossaZoneDetail">Dettaglio zona</label>
                                            <input id="moscarossaZoneDetail" name="zoneDetail" type="text"
                                                maxlength="150" class="form-control"
                                                placeholder="Es: vicino alla stazione">
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="innerB">
                                            <label for="moscarossaWebsite">Sito web personale</label>
                                            <input id="moscarossaWebsite" name="website" type="url" maxlength="250"
                                                class="form-control">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="moscarossa-form-section">
                                <h4 class="moscarossa-form-section-title">Dati annuncio</h4>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaName">Nome *</label>
                                            <input id="moscarossaName" name="name" type="text" maxlength="30"
                                                class="form-control" required>
                                        </div>
                                        <div class="innerB">
                                            <label for="moscarossaAge">Età</label>
                                            <input id="moscarossaAge" name="age" type="number" min="18" max="99"
                                                class="form-control">
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="innerB">
                                            <label for="moscarossaCategory">Categoria *</label>
                                            <select id="moscarossaCategory" name="categorie" class="form-control" required>
                                                <option value="">Seleziona una categoria</option>
                                                <option value="DONNAUOMO">Escort donne</option>
                                                <option value="TRANS">Trans</option>
                                                <option value="UOMODONNA">Gigolò</option>
                                                <option value="MASSAGGI">Massaggi</option>
                                            </select>
                                        </div>
                                        <div class="innerB">
                                            <div class="flex-checkbox">
                                                <input id="moscarossaAirConditioned" name="airConditioned" type="checkbox">
                                                <label for="moscarossaAirConditioned">Ambiente climatizzato</label>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="phone-panel moscarossa-phone-panel">
                                            <label for="moscarossaPhone">Contatto telefonico *</label>
                                            <div class="phone-wrapper">
                                                <input id="moscarossaPhone" name="phone" type="tel" maxlength="50"
                                                    class="form-control" required>
                                                <button id="verify-button" type="button" class="btn btn-secondary">
                                                    <span><i class="fa fa-arrow-right"></i></span>
                                                </button>
                                            </div>
                                            <p id="test-label">Verifica</p>
                                            <div class="flex-checkbox" style="margin-bottom: 5px;">
                                                <input id="moscarossaWhatsapp" name="whatsapp" type="checkbox">
                                                <label for="moscarossaWhatsapp">WhatsApp</label>
                                            </div>
                                            <div class="flex-checkbox" style="margin-bottom: 5px;">
                                                <input id="moscarossaTelegram" name="telegram" type="checkbox">
                                                <label for="moscarossaTelegram">Telegram</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <details id="moscarossaDetails" class="moscarossa-details">
                                <summary>Ulteriori specifiche</summary>
                                <div class="moscarossa-details-body">
                                    <h4>Tariffe</h4>
                                    <div id="moscarossaTariffs" class="moscarossa-tariff-list"></div>
                                    <h4>Servizi</h4>
                                    <div id="moscarossaServices" class="moscarossa-details-grid services"></div>
                                    <h4>Caratteristiche</h4>
                                    <div id="moscarossaSpecifications" class="moscarossa-details-grid"></div>
                                    <div id="moscarossaMultiSpecifications"></div>
                                </div>
                            </details>

                            <input id="moscarossaZoneId" name="zoneId" type="hidden">
                            <input id="moscarossaLatitude" name="latitude" type="hidden">
                            <input id="moscarossaLongitude" name="longitude" type="hidden">

                            <div class="innerB moscarossa-save-row">
                                <button id="moscarossaSaveInfo" type="submit" class="btn btn-info"
                                    style="width: 100%;">
                                    <b>SALVA</b>
                                </button>
                                <div id="moscarossaUpdateAllSection">
                                    <div class="separator"></div>
                                    <div class="center text-muted">
                                        <span>------------</span> Oppure <span>------------</span>
                                    </div>
                                    <div class="separator"></div>
                                    <button id="moscarossaUpdateAll" type="button" class="btn btn-warning"
                                        style="width:100%;">
                                        <b>MODIFICA TUTTI GLI ANNUNCI</b>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="widget widget-heading-simple widget-body-gray widget-after" id="moscarossaPublications">
                    <div class="widget-head">
                        <h3 class="heading glyphicons edit"><i></i>Pubblicazioni</h3>
                    </div>
                    <div class="widget-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="promo wizard">
                                    <input id="moscarossaScheduleDate" type="date"
                                        style="width:160px; margin-bottom:25px;" class="form-control hidden">
                                    <div class="widget widget-tabs widget-tabs-responsive">
                                        <div class="widget-body">
                                            <div class="row">
                                                <div class="col-md-4 col-md-offset-4">
                                                    <div id="moscarossaCalendarContainer"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="promoType widget-head" style="margin-bottom:0;">
                                            <ul id="moscarossaPromotionTabs">
                                                <li class="active">
                                                    <a href="#" role="button" data-moscarossa-plan="Free">Free</a>
                                                </li>
                                                <li><a href="#" role="button" data-moscarossa-plan="Premium"
                                                        style="background-color:#f29acb;">Premium</a></li>
                                                <li><a href="#" role="button" data-moscarossa-plan="Top"
                                                        style="background-color:#d0d174;">Top</a></li>
                                                <li><a href="#" role="button" data-moscarossa-plan="Red"
                                                        style="background-color:#ef7f88;">Red</a></li>
                                                <li><a href="#" role="button" data-moscarossa-plan="Gold"
                                                        style="background-color:#f3df63;">Gold</a></li>
                                            </ul>
                                        </div>
                                        <div class="widget-body" id="moscarossaWizardBody">
                                            <div class="tab-content">
                                                <div class="promoPanel promoFree tab-pane active animated fadeInUp"
                                                    id="moscarossaTabFree">
                                                    <div class="posts">
                                                        <div id="moscarossaScheduleList" class="post-list"></div>
                                                        <button id="moscarossaAddSchedule" type="button"
                                                            class="btn btn-primary free-add-schedule">
                                                            <span><b><i class="fa fa-plus"></i></b></span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="separator"></div>
                                    <button id="moscarossaSaveSchedule" type="button" class="btn btn-success"
                                        style="width:100%;" disabled>
                                        <b>PUBBLICA/MODIFICA TUTTI GLI ANNUNCI</b>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="widget widget-heading-simple widget-body-gray widget-after">
                    <div class="widget-head">
                        <h3 class="heading glyphicons edit"><i></i>Immagini</h3>
                        <button class="input-editor btn btn-success pull-right" id="moscarossaShowRemoved"
                            type="button" aria-label="Mostra immagini rimosse">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>
                    <div class="widget-body">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="pics-section">
                                    <div class="pics persistent" id="moscarossaActiveImages">
                                        <div class="dragHere"
                                            style="position:absolute; width:100%; height:100%; background-color:#8597d8; opacity:.8; display:none; z-index:1000;">
                                            <div
                                                style="position:relative; width:calc(100% - 20px); height:calc(100% - 20px); border:dashed 10px #ddd; border-radius:50px; margin:10px;">
                                                <div style="font-size:5em; text-align:center; padding:80px 0 0;">
                                                    <span class="fa fa-cloud-upload" style="color:white;"></span>
                                                </div>
                                                <h1 style="color:white; font-size:3em; text-align:center; padding:30px;">
                                                    Trascina Qui
                                                </h1>
                                            </div>
                                        </div>
                                        <input id="moscarossaImages" type="file" accept="image/*" multiple
                                            style="display:none;">
                                        <label for="moscarossaImages">
                                            <div class="add-pic"><b><i class="fa fa-plus"></i></b></div>
                                        </label>
                                        <div id="moscarossaImageGrid" class="moscarossa-image-grid"></div>
                                    </div>
                                    <div class="pics removed" id="moscarossaRemovedImages">
                                        <div id="moscarossaRemovedImageGrid" class="moscarossa-image-grid"></div>
                                    </div>
                                    <p class="help-block">Massimo 20 immagini, 5 MB per file. Clicca una foto per
                                        impostarla come anteprima.</p>
                                    <p id="moscarossaNewAdImageHelp"
                                        class="help-block moscarossa-pending-note" style="display:none;">
                                        Salva prima le informazioni dell'annuncio, quindi aggiungi le immagini.
                                    </p>
                                    <button id="moscarossaSaveImages" type="button" class="btn btn-primary"
                                        style="width:100%; margin-top:20px;">
                                        <b>MODIFICA LE IMMAGINI</b>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="customModal" class="custom-modal" aria-hidden="true">
                    <div class="custom-modal-content">
                        <div class="custom-modal-header">
                            <span class="custom-modal-title">Modifica immagine</span>
                            <button id="closeModalButton" type="button" class="custom-modal-close">&times;</button>
                        </div>
                        <div class="custom-modal-body">
                            <img id="modalImage" src="" alt="Immagine da modificare" style="max-width:100%;">
                        </div>
                        <div class="custom-modal-footer">
                            <button id="saveCropButton" type="button" class="custom-modal-save">Salva Anteprima</button>
                        </div>
                    </div>
                </div>

                <div class="widget widget-body-gray widget-after" id="moscarossaHistory">
                    <div class="widget-head" style="background:#eaeaea;">
                        <h3 class="heading glyphicons edit" style="margin-left:-10px;"><i></i>Storico Pubblicazioni</h3>
                        <span class="text-default pull-right moscarossa-copy-all">Copia le uscite</span>
                        <a id="moscarossaCopyHistory" class="btn btn-xs pull-right moscarossa-copy-all">
                            <i class="fa fa-copy" style="font-size:27px; line-height:27px;"></i>
                        </a>
                        <span class="text-default pull-right">Condividi</span>
                        <a id="moscarossaWhatsappHistory" class="btn btn-xs pull-right"
                            href="whatsapp://send?text=" target="_blank">
                            <i class="fa fa-whatsapp" style="font-size:27px; line-height:27px;"></i>
                        </a>
                    </div>
                    <div class="widget-head">
                        <div class="col-md-2 col-sm-2"><div class="row"><h4 class="heading"> </h4></div></div>
                        <div class="col-md-4 col-sm-4"><div class="row"><h4 class="heading">Descrizione (citt&agrave;)</h4></div></div>
                        <div class="col-md-4 col-sm-4"><div class="row"><h4 class="heading" style="float:none;">Stato</h4></div></div>
                        <div class="col-md-1 col-sm-1"><div class="row"><h4 class="heading" style="float:none;">Pagati</h4></div></div>
                    </div>
                    <div class="widget-body" style="padding-top:0;">
                        <div class="row">
                            <div id="moscarossaHistoryList" class="col-md-12">
                                <div class="row center moscarossa-history-empty">Nessun dato rilevato</div>
                            </div>
                        </div>
                        <div class="row">
                            <div id="moscarossaHistorySuspendedTitle"
                                class="col-md-12 text-danger" style="text-align:center;">
                                <div class="separator"></div>
                                <h5 class="strong">Pubblicazioni Sospese</h5>
                            </div>
                            <div id="moscarossaHistorySuspendedList" class="col-md-12">
                                <div class="row center moscarossa-history-empty">Nessun dato rilevato</div>
                            </div>
                            <div class="col-md-4 moscarossa-history-bulk">
                                <button id="moscarossaShowSuspended" type="button" class="btn btn-primary">
                                    <b>MOSTRA SOSPESI</b>
                                </button>
                            </div>
                            <div class="col-md-4 moscarossa-history-bulk">
                                <button id="moscarossaSuspendPublished" type="button" class="btn btn-danger strong">
                                    <b>SOSPENDI PUBBLICATI</b>
